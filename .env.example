# Variáveis de ambiente do proxy OAuth do Decap CMS (Fase 5,
# task-001-migracao-stack). NENHUM valor real deve ser commitado aqui —
# este ficheiro é só documentação de quais variáveis existem. Configurar os
# valores reais na Vercel (Project Settings → Environment Variables),
# restrição vinculativa 27: os segredos abaixo só em Production; Preview
# usa uma GitHub OAuth App e um repositório-sandbox separados (ver
# handoff-38-developer-fase5.md).

# ID de cliente da GitHub OAuth App (não é segredo, mas também não precisa
# de estar em NEXT_PUBLIC_ — só é usado no servidor).
GITHUB_OAUTH_CLIENT_ID=

# Client secret da GitHub OAuth App. SEGREDO — nunca commitar, nunca
# expor ao browser, nunca em public/admin/config.yml.
GITHUB_OAUTH_CLIENT_SECRET=

# Segredo dedicado para assinar (HMAC-SHA256) o cookie de sessão. SEGREDO —
# distinto do GITHUB_OAUTH_CLIENT_SECRET. Gerar com, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Pelo menos 32 caracteres.
SESSION_SECRET=

# Origem ABSOLUTA e ÚNICA deste deployment, sem barra final
# (ex.: "https://agrotrades.co.mz" em produção, ou o alias estável do
# ambiente de preview/sandbox — nunca um URL de preview efémero). Tem de
# ser IGUAL, byte a byte, a `backend.base_url` em public/admin/config.yml.
OAUTH_ALLOWED_ORIGIN=

# Variáveis do formulário de contacto (app/api/contact/route.ts) — envia
# email via Resend (resend.com), sem base de dados própria.

# API key do Resend. SEGREDO — nunca commitar, nunca expor ao browser,
# nunca em public/admin/config.yml. Criar em resend.com → API Keys.
RESEND_API_KEY=

# Opcional. Endereço "from" usado no envio. Sem isto, usa o endereço de
# testes do Resend (onboarding@resend.dev) — funciona, mas com limites e
# sem aspeto profissional. Só funciona com um domínio verificado no Resend
# (ex.: "AGRO TRADES <contacto@agrotrades.co.mz>").
RESEND_FROM_EMAIL=
