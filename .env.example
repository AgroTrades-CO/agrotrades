# ---------------------------------------------------------------------------
# Formulário de contacto (app/api/contact/route.ts, lib/contact/env.ts,
# task-006-contact-form-security). Envia email via Resend (resend.com), com
# anti-spam Cloudflare Turnstile. Sem base de dados própria.
#
# Configurar na Vercel (Project Settings -> Environment Variables), por
# ambiente: Production / Preview / Development. Os valores REAIS existem SÓ
# em Production. Preview (todos os deployments que não são de produção,
# incluindo branches do CMS) e Development/dev local usam
# CONTACT_DELIVERY_MODE=dry-run com as chaves de TESTE públicas da
# Cloudflare (nenhum email é enviado). Na Vercel, as variáveis ficam
# disponíveis no build e em runtime. Marcar como "Sensitive" SÓ as chaves
# (RESEND_API_KEY e a TURNSTILE_SECRET_KEY real).
# ---------------------------------------------------------------------------

# Modo de entrega, OBRIGATÓRIO e sem valor por omissão: "send" (só
# Production) ou "dry-run" (todos os outros ambientes: valida tudo, incluindo
# o Turnstile, mas nunca contacta o Resend). Ausente ou inválido -> 503.
CONTACT_DELIVERY_MODE=

# Email único que recebe as mensagens (ex.: "contacto@example.com"). Só em
# Production e nunca no CMS (SEC-C-01): o que se protege é quem o pode
# ALTERAR, não o valor. NÃO é segredo (SEC-N-01): o endereço aparece
# publicamente no site; não marcar como "Sensitive" na Vercel. Só lido em
# modo "send".
CONTACT_RECIPIENT_EMAIL=

# Origem canónica do site, https:// sem caminho nem barra final
# (ex.: "https://www.example.com"). Só em Production (modo "send"): usada
# para recusar pedidos de outras origens e para verificar o hostname
# devolvido pelo Turnstile.
CONTACT_SITE_ORIGIN=

# API key do Resend. SEGREDO ("Sensitive" na Vercel) — só em Production,
# nunca commitar, nunca expor ao browser, nunca em public/admin/config.yml.
# Criar em resend.com -> API Keys, com permissão só de envio e restrita ao
# domínio verificado.
RESEND_API_KEY=

# Endereço "from", OBRIGATÓRIO em modo "send" (sem fallback). Tem de ser de
# um domínio verificado no Resend (ex.: "Empresa <contacto@example.com>").
RESEND_FROM_EMAIL=

# Cloudflare Turnstile (painel da Cloudflare -> Turnstile, widget em modo
# Managed, hostname só o domínio canónico de produção).
# Secret key: SEGREDO ("Sensitive" na Vercel). Production: a real. Outros
# ambientes: a de teste "1x0000000000000000000000000000000AA" (passa
# sempre). Em "dry-run" só são aceites as secrets de teste oficiais; em
# "send" (build/start de produção) uma secret de teste é recusada.
TURNSTILE_SECRET_KEY=
# Site key: pública (vai para o HTML), mas SEM prefixo NEXT_PUBLIC_ de
# propósito. Production: a real. Outros ambientes: a de teste
# "1x00000000000000000000AA". Num deploy de produção (VERCEL_ENV=production,
# definida pela Vercel) ou num build com CONTACT_DELIVERY_MODE=send, se faltar
# ou for de teste, o build FALHA. Num deploy de produção, o build também
# falha com CONTACT_DELIVERY_MODE=dry-run ou com uma TURNSTILE_SECRET_KEY de
# teste (e a rota responde 503).
TURNSTILE_SITE_KEY=

# Bloco para desenvolvimento local (copiar para .env.local, que está no
# .gitignore). Chaves de TESTE públicas da Cloudflare, nenhum email é enviado:
#   CONTACT_DELIVERY_MODE=dry-run
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Para testar falhas: site key 2x00000000000000000000AB (widget falha),
# 3x00000000000000000000FF (desafio interativo); secret
# 2x0000000000000000000000000000000AA (recusa) ou
# 3x0000000000000000000000000000000AA (token já usado).
